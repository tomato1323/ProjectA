---
import type { GetStaticPaths } from "astro";
import Layout from '@/layouts/Layout.astro';
import restaurants from '@/restaurants.json'

import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{default: ImageMetadata}>('@/assets/*', {eager:true});
const images = Object.fromEntries(
    Object.entries(imageFiles).map(([path, module]) => {
        const fileName = path.split('/').pop()?.split('.')[0] || '';
        return [fileName, module.default]
    })
)

export  const getStaticPaths = (() => {
    return restaurants.map((item) => {
        return {
            params: { slug: item.img },
            props: { item }
        }
    });
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const { item } = Astro.props;

---

<Layout title="Project A">
    <div class="max-w-4xl mx-auto px-5 md:px-10 py-10">
        <section class="mb-5">
            <!-- タイトル -->
            <h1 class=`
                text-3xl md:text-4xl
                font-bold tracking-tight
                text-gray-900
            ` >{item.name}</h1>
        </section>

        <div class=`
            bg-white rounded-3xl shadow-sm
            border border-gray-100
            overflow-hidden
            p-5 md:p-10
            space-y-10
        `>
            <section>
                <!-- 紹介 -->
                <div class=`
                    grid grid-cols-1 md:grid-cols-2
                    gap-10 items-center
                ` >
                    <!-- Grid化 -->
                    <div>
                        <h2 class=`
                            text-lg font-semibold
                            text-gray-800
                            flex items-center
                        ` >
                            お店について
                        </h2>
                        <!-- 文字 -->
                        <p class=`
                            text-gray-600
                        ` >
                            {item.desc}
                        </p>
                    </div>
                    <div>
                        <!-- 画像 -->
                         <Image
                         src={images[item.img]}
                         alt={item.name}
                         class={`
                            relative overflow-hidden
                            rounded-2xl shadow-md
                         `}
                         />
                    </div>
                </div>
            </section>

            <section>
                <!-- 地図 -->
                <h2 class=`
                    text-lg font-semibold text-gray-800
                    mb-5 flex items-center
                ` >
                    マップ
                </h2>
                <div class=`
                    w-full h-100 md:h-120
                    rounded-2xl overflow-hidden
                    shadow-inner
                ` >
                    <iframe src={item.map}
                    width="100%" height="100%"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin"
                    class="w-full h-full"
                    />
                </div>
            </section>
        </div>
    </div>
</Layout>